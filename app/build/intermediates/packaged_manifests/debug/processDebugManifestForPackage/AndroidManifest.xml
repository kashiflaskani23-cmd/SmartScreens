<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.example.smartscreens"
    android:versionCode="1"
    android:versionName="1.0" >

    <uses-sdk
        android:minSdkVersion="23"
        android:targetSdkVersion="34" />

    <permission
        android:name="com.example.smartscreens.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />

    <uses-permission android:name="com.example.smartscreens.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <application
        android:allowBackup="true"
        android:appComponentFactory="androidx.core.app.CoreComponentFactory"
        android:debuggable="true"
        android:extractNativeLibs="false"
        android:icon="@drawable/ic_smart_logo"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_smart_logo"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartScreens" >

        <!-- Screen 1: Splash Screen (Launcher Activity with dedicated Splash Theme) -->
        <activity
            android:name="com.example.smartscreens.SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.SmartScreens.Splash" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Screen 2: Login Screen -->
        <activity
            android:name="com.example.smartscreens.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 3: Registration Screen -->
        <activity
            android:name="com.example.smartscreens.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 4: Forgot Password Screen -->
        <activity
            android:name="com.example.smartscreens.ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 5: Reset Password Screen -->
        <activity
            android:name="com.example.smartscreens.ResetPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Screen 6: Dashboard Screen -->
        <activity
            android:name="com.example.smartscreens.DashboardActivity"
            android:exported="false" />

        <!-- Screen 7: Profile Screen -->
        <activity
            android:name="com.example.smartscreens.ProfileActivity"
            android:exported="false" />

        <!-- Interactive Module 1: Home Control Center -->
        <activity
            android:name="com.example.smartscreens.HomeActivity"
            android:exported="false" />

        <!-- Interactive Module 2: Tools & Diagnostics -->
        <activity
            android:name="com.example.smartscreens.ToolsActivity"
            android:exported="false" />

        <!-- Interactive Module 3: Activity & Audit History -->
        <activity
            android:name="com.example.smartscreens.HistoryActivity"
            android:exported="false" />

        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="com.example.smartscreens.androidx-startup"
            android:exported="false" >
            <meta-data
                android:name="androidx.emoji2.text.EmojiCompatInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.lifecycle.ProcessLifecycleInitializer"
                android:value="androidx.startup" />
            <meta-data
                android:name="androidx.profileinstaller.ProfileInstallerInitializer"
                android:value="androidx.startup" />
        </provider>

        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            android:directBootAware="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.DUMP" >
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.INSTALL_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SKIP_FILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.SAVE_PROFILE" />
            </intent-filter>
            <intent-filter>
                <action android:name="androidx.profileinstaller.action.BENCHMARK_OPERATION" />
            </intent-filter>
        </receiver>
    </application>

</manifest>